+// Small DOM doubles exercise the production coordinator, not browser layout or
+// React's renderer. Only Node built-ins and the project's existing TS compiler.
+function harness() {
+  const jobs = [];
+  const listeners = new Map();
+  const observers = [];
+  let document;
+  class Element {
+    constructor(tag = 'div') {
