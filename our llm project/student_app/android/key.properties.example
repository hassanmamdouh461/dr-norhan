# Example key.properties for tech.synapticstudio.drphysics Android Release builds
# Rename this file to 'key.properties' and place it in the same directory (student_app/android/).
# Ensure you do NOT commit the actual 'key.properties' file or your keystore (.jks) to Git.

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=key
storeFile=app/release.jks
