# عنوان الـ API — يُملأ بعد النشر (نطاق الـ Worker، مثال: https://fusha-api.<subdomain>.workers.dev).
# اتركه فارغاً في التطوير لتُصبح الطلبات نسبية على نفس النطاق.
VITE_API_URL=

# المضيف العام لحاوية R2 (مثال: <bucket-id>.r2.cloudflarestorage.com) — يُملأ بعد النشر.
# عند تركه فارغاً يُتجاوز تحسين صور الأغلفة. يجب أن يطابق R2_PUBLIC_HOST في functions/cdn-img.ts.
VITE_R2_PUBLIC_HOST=

# ملاحظة: لا توجد أي متغيرات لمزوّد هوية خارجي — المصادقة أصبحت أصلية على
# Cloudflare Worker عبر /auth/login و /auth/register و /auth/refresh،
# ولا تحتاج أي إعداد في الواجهة.

# ── Firebase (إشعارات Push) ──
# ⚠️ المشروع الحالي في src/services/firebase.ts هو `synaptic-3ef0d`،
#    مشروع خارجي قديم — يحتاج ترحيلاً يدوياً. هذه القيم تُجاوز إن وُجدت.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
